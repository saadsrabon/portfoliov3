---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { bootstrapConfiguration } from "../../lib/bootstrap";
const setupConfigured = Boolean(bootstrapConfiguration());
Astro.response.headers.set("Cache-Control", "no-store");
---
<SiteLayout title="First admin setup - Saad" description="Provision the first private portfolio administrator." noindex={true} showFeedback={false}>
  <section class="container admin-login-shell" aria-labelledby="setup-title">
    <a class="text-link" href="/admin/login/">← Admin sign in</a><p class="eyebrow" style="margin-top:34px">One-time setup</p><h1 id="setup-title">Provision the first admin</h1>
    <p class="case-lede">This page works only while the server has a short-lived setup code configured and no admin exists. Enter a new password here; do not reuse a credential shared in chat.</p>
    {setupConfigured ? <form class="admin-form-card" id="bootstrap-form">
      <label>Admin email<input name="email" type="email" autocomplete="username" required maxlength="254" /></label>
      <label>Display name<input name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" /></label>
      <label>New password<input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" /></label>
      <label>One-time setup secret<input name="capability" type="password" autocomplete="off" required minlength="43" maxlength="43" /></label>
      <button class="button" type="submit">Create admin <span aria-hidden="true">↗</span></button>
      <p class="admin-message" id="bootstrap-message" role="status" aria-live="polite"></p>
    </form> : <div class="case-disclaimer"><strong>Setup is not configured.</strong><p>Follow the secure setup instructions in the project documentation.</p></div>}
  </section>
  {setupConfigured && <script>
    let csrfToken = "";
    const form = document.querySelector<HTMLFormElement>("#bootstrap-form");
    const message = document.querySelector<HTMLElement>("#bootstrap-message");
    const loadToken = async () => {
      try {
        const response = await fetch("/api/admin/bootstrap-token", { cache: "no-store", credentials: "same-origin" });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "First-admin setup is unavailable.");
        csrfToken = result.csrfToken;
      } catch (error) { if (message) message.textContent = error instanceof Error ? error.message : "Setup is unavailable."; }
    };
    void loadToken();
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!message || !form.reportValidity()) return;
      const values = new FormData(form);
      const payload = { email: values.get("email"), name: values.get("name"), password: values.get("password"), capability: values.get("capability") };
      const passwordInput = form.elements.namedItem("password") as HTMLInputElement | null;
      const secretInput = form.elements.namedItem("capability") as HTMLInputElement | null;
      if (passwordInput) passwordInput.value = "";
      if (secretInput) secretInput.value = "";
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']"); if (button) button.disabled = true;
      message.textContent = "Provisioning…";
      try {
        const response = await fetch("/api/admin/bootstrap", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken }, body: JSON.stringify(payload) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Setup failed.");
        form.reset();
        message.textContent = "Admin created. Remove ADMIN_BOOTSTRAP_HASH and ADMIN_BOOTSTRAP_EXPIRES_AT in the hosting settings, then sign in and finish authenticator setup.";
      } catch (error) { message.textContent = error instanceof Error ? error.message : "Setup failed. Please retry."; }
      finally { if (button) button.disabled = false; }
    });
  </script>}
</SiteLayout>
