---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getAuth } from "../../lib/auth";
let status = "ready";
let isAdmin = false;
try {
  const auth = await getAuth();
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  isAdmin = Boolean(session?.user.role === "admin");
  if (!isAdmin) return Astro.redirect("/admin/login/");
  if (session?.user.twoFactorEnabled) return Astro.redirect("/admin/");
} catch { status = "unavailable"; }
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<SiteLayout title="Secure admin access - Saad" description="Set up an authenticator for the portfolio admin." noindex={true} showFeedback={false}>
  <section class="container admin-login-shell" aria-labelledby="mfa-title">
    <a class="text-link" href="/admin/login/">← Admin sign in</a><p class="eyebrow" style="margin-top:34px">Required before admin tools</p><h1 id="mfa-title">Set up an authenticator</h1>
    {status === "unavailable" ? <div class="case-disclaimer"><strong>Admin services are not configured.</strong><p>Connect and migrate the private database and set the authentication secrets before signing in.</p></div> : <>
      <p class="case-lede">Use an authenticator app to scan the code. The QR is generated in this browser and is not sent to a third-party service. Save the recovery codes somewhere private.</p>
      <div class="admin-form-card" id="enroll-card">
        <label>Confirm your current password<input id="mfa-password" type="password" autocomplete="current-password" required minlength="12" maxlength="128" /></label>
        <button class="button" id="start-mfa" type="button">Generate authenticator setup</button>
        <p class="admin-message" id="mfa-message" role="status" aria-live="polite"></p>
        <div id="mfa-enrollment" hidden>
          <canvas id="mfa-qr" aria-label="Authenticator enrollment QR code"></canvas>
          <p>Manual setup key: <code id="mfa-secret"></code></p>
          <h2>Recovery codes</h2><p>Save these now. They are shown only during enrollment.</p><pre id="mfa-backup" class="backup-codes"></pre>
          <form id="mfa-verify-form"><label>Enter a code from the authenticator<input name="code" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" required /></label><button class="button" type="submit">Confirm and finish</button></form>
        </div>
      </div>
    </>}
  </section>
  {status === "ready" && isAdmin && <script>
    import { createAuthClient } from "better-auth/client";
    import { twoFactorClient } from "better-auth/client/plugins";
    import QRCode from "qrcode";
    const client = createAuthClient({ plugins: [twoFactorClient()] });
    const message = document.querySelector<HTMLElement>("#mfa-message");
    document.querySelector<HTMLButtonElement>("#start-mfa")?.addEventListener("click", async () => {
      const password = document.querySelector<HTMLInputElement>("#mfa-password")?.value;
      if (!password || !message) return;
      message.textContent = "Creating authenticator setup…";
      try {
        const result = await client.twoFactor.enable({ password, method: "totp" });
        if (result.error || !result.data || result.data.method !== "totp") throw new Error("Could not start authenticator setup. Check your password and try again.");
        await QRCode.toCanvas(document.querySelector<HTMLCanvasElement>("#mfa-qr"), result.data.totpURI, { width: 216, margin: 1 });
        const uri = new URL(result.data.totpURI);
        document.querySelector<HTMLElement>("#mfa-secret")!.textContent = uri.searchParams.get("secret") ?? "See your authenticator app.";
        document.querySelector<HTMLElement>("#mfa-backup")!.textContent = result.data.backupCodes.join("\n");
        document.querySelector<HTMLElement>("#mfa-enrollment")!.hidden = false;
        message.textContent = "Scan the QR code, save the recovery codes, and verify the first code.";
      } catch (error) { message.textContent = error instanceof Error ? error.message : "Could not start authenticator setup."; }
    });
    document.querySelector<HTMLFormElement>("#mfa-verify-form")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const code = String(new FormData(form).get("code"));
      try {
        const result = await client.twoFactor.verifyTotp({ code, trustDevice: false });
        if (result.error) throw new Error("Code not accepted. Check the device clock and try again.");
        window.location.assign("/admin/");
      } catch (error) { if (message) message.textContent = error instanceof Error ? error.message : "Verification failed."; }
    });
  </script>}
</SiteLayout>
