---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Verify sign in - Saad" description="Verify your admin sign-in." noindex={true} showFeedback={false}>
  <section class="container admin-login-shell" aria-labelledby="verify-title">
    <a class="text-link" href="/admin/login/">← Sign in</a><p class="eyebrow" style="margin-top:34px">Authenticator check</p><h1 id="verify-title">Enter your code</h1>
    <p class="case-lede">Enter the current code from your authenticator app. You can use a recovery code if needed.</p>
    <form class="admin-form-card" id="verify-form"><label>Authenticator or recovery code<input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" required minlength="6" maxlength="24" /></label><button class="button" type="submit">Verify <span aria-hidden="true">↗</span></button><p class="admin-message" role="status" aria-live="polite"></p></form>
  </section>
  <script>
    import { createAuthClient } from "better-auth/client";
    import { twoFactorClient } from "better-auth/client/plugins";
    const authClient = createAuthClient({ plugins: [twoFactorClient()] });
    const form = document.querySelector<HTMLFormElement>("#verify-form");
    const message = document.querySelector<HTMLElement>(".admin-message");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault(); if (!message || !form.reportValidity()) return;
      const values = new FormData(form); const code = String(values.get("code")).replace(/\s+/gu, "");
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']"); if (button) button.disabled = true;
      message.textContent = "Checking…";
      try {
        const result = /^\d{6}$/u.test(code) ? await authClient.twoFactor.verifyTotp({ code, trustDevice: false }) : await authClient.twoFactor.verifyBackupCode({ code, trustDevice: false });
        if (result.error) throw new Error("That code was not accepted. Try the next code or a saved recovery code.");
        window.location.assign("/admin/");
      } catch (error) { message.textContent = error instanceof Error ? error.message : "Code verification failed."; }
      finally { if (button) button.disabled = false; }
    });
  </script>
</SiteLayout>
