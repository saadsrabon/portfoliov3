---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { caseStudies, conceptProjects } from "../../data/site";

export const prerender = true;

export function getStaticPaths() {
  return [
    ...conceptProjects.map((project) => ({ params: { slug: project.slug }, props: { project, concept: true } })),
    ...caseStudies.map((project) => ({ params: { slug: project.slug }, props: { project, concept: false } })),
  ];
}

const { project, concept } = Astro.props;
const title = `${project.name} — ${concept ? "Concept" : "Project notes"}`;
---
<SiteLayout active="work" title={`${title} - Saad`} description={project.summary ?? project.description}>
  <article class="container case-study">
    <a class="text-link case-back" href="/work/">← All work</a>
    <header class="case-hero"><p class="eyebrow">{concept ? `${project.category} · Independent concept` : project.group}</p><h1>{project.name}</h1><p class="case-lede">{concept ? project.summary : project.description}</p>
      <div class="case-meta"><span><b>Type</b>{concept ? "Independent concept" : "Selected product work"}</span><span><b>Role</b>{project.role}</span><span><b>Stack / areas</b>{project.tags.join(" · ")}</span></div>
      {project.url && <a class="button" href={project.url} target="_blank" rel="noopener noreferrer">{concept ? "Open live concept" : project.slug === "job-engineer" ? "Visit JobOS site" : "Visit live project"} <span aria-hidden="true">↗</span></a>}
    </header>
    {!concept && project.illustrations.length > 0 && <section class="case-section" aria-labelledby="illustrations-title">
      <div class="case-section-heading"><div><p class="eyebrow">Product illustrations</p><h2 id="illustrations-title">Inside JobOS</h2></div><p>Original feature illustrations from the Job Engineer landing-page repository, showing the browser extension, resume tools, email writer, interview workspace and analytics.</p></div>
      <div class="case-illustration-grid" data-motion-stagger>{project.illustrations.map((image) => <figure class="case-illustration" data-motion-card><img src={image.src} alt={image.alt} width="800" height="500" loading="lazy" /><figcaption>{image.title}</figcaption></figure>)}</div>
      <p class="case-illustration-note">These illustrations use example names, roles and dashboard values to show the feature interfaces. <a href="https://github.com/saadsrabon/Job-Engineer/tree/main/apps/landing/public/landing/features" target="_blank" rel="noopener noreferrer">View the original feature assets on GitHub <span aria-hidden="true">↗</span></a></p>
    </section>}
    {concept ? <>
      <section class="case-section" aria-labelledby="gallery-title"><div class="case-section-heading"><div><p class="eyebrow">Rendered pages</p><h2 id="gallery-title">A closer look</h2></div><p>Authentic screenshots of the live concept, captured at desktop and mobile sizes.</p></div>
        <div class="case-gallery" data-motion-stagger>{project.gallery.map((image) => <figure class="device-shot" data-motion-card><figcaption>{image.label}</figcaption><div class:list={["device-frame", image.label === "Mobile view" ? "device-mobile" : "device-desktop"]}><img src={image.src} alt={image.alt} loading="lazy" /></div></figure>)}</div>
      </section>
      <section class="case-section case-two-col"><div><p class="eyebrow">Page structure</p><h2>What the concept explores</h2></div><ul class="case-list">{project.sections.map((section) => <li>{section}</li>)}</ul></section>
      <section class="case-section case-two-col"><div><p class="eyebrow">Approach</p><h2>From direction to responsive page</h2></div><ol class="case-list">{project.process.map((step) => <li>{step}</li>)}</ol></section>
      <aside class="case-disclaimer"><strong>Concept disclosure</strong><p>{project.note}</p></aside>
    </> : <>
      <section class="case-story-grid" aria-label={`${project.name} case study`}>
        <section class="case-story"><p class="eyebrow">01 / Challenge</p><h2>The problem</h2><p>{project.problem}</p></section>
        <section class="case-story"><p class="eyebrow">02 / Engineering</p><h2>The solution</h2><p>{project.solution}</p></section>
        <section class="case-story case-story-impact"><p class="eyebrow">03 / Outcome</p><h2>What it enables</h2><p>{project.impact}</p></section>
      </section>
      {project.url && <section class="case-live-panel"><div><p class="eyebrow">Explore the product</p><h2>See {project.name} in action</h2><p>Open the current public site to explore the experience.</p></div><a class="button" href={project.url} target="_blank" rel="noopener noreferrer">{project.slug === "job-engineer" ? "Visit JobOS site" : "Visit live project"} <span aria-hidden="true">↗</span></a></section>}
      <section class="case-section case-two-col"><div><p class="eyebrow">Technology</p><h2>Tools and systems</h2></div><ul class="case-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul></section>
    </>}
    <nav class="case-next" aria-label="Case study navigation"><a class="text-link" href="/work/">← Back to selected work</a>{concept && <a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit live concept ↗</a>}</nav>
  </article>
</SiteLayout>
