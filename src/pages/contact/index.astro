---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../data/site";
---
<SiteLayout active="contact" title="Contact — Saad" description="Get in touch with Saad about full-time remote roles, product engineering projects, or technical collaboration.">
  <header class="container page-intro"><p class="eyebrow">Contact</p><h1>Tell me what you want to build.</h1><p>I’ll reply with a few questions and an honest view of the scope. A short email is a good place to start.</p></header>
  <section class="container section">
    <div class="contact-grid">
      <article class="contact-block"><h2>Work together</h2><p>Full-time remote roles across frontend, backend, or full stack. Project work in web apps, APIs, WordPress, and WooCommerce. I also help with API performance, data models, and AWS deployments.</p><div class="contact-links"><a class="text-link" href="/book/">Book an introductory call <span aria-hidden="true">→</span></a><a href="mailto:saadsrabon2@gmail.com?subject=Project%20or%20role%20inquiry">Email a brief <span aria-hidden="true">↗</span></a></div></article>
      <article class="contact-block"><h2>Find me</h2><p>Based in {site.location}, GMT+6, with overlap for EU and US working hours.</p><div class="contact-links"><a href={site.github} target="_blank" rel="noreferrer">github.com/saadsrabon <span aria-hidden="true">↗</span></a><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={"mailto:" + site.email}>{site.email} <span aria-hidden="true">↗</span></a></div></article>
    </div>
  </section>
  <section class="container callout" data-reveal><h2>Share a little context and I’ll take it from there.</h2><a class="button" href="mailto:saadsrabon2@gmail.com?subject=Let%27s%20talk">Email Saad <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
