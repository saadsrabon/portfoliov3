---
import { eq } from "drizzle-orm";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { posts } from "../../db/schema";
import { getDatabase } from "../../lib/database";
import { renderSafeMarkdown } from "../../lib/cms";
import { adminSession } from "../../lib/security";

const slug = Astro.params.slug ?? "";
const [post] = await (await getDatabase()).select().from(posts).where(eq(posts.slug, slug)).limit(1);
if (!post || post.status !== "published") {
  const access = await adminSession(Astro.request);
  if (!post || access.response) return Astro.redirect("/blog/");
}
const bodyHtml = await renderSafeMarkdown(post.bodyMarkdown);
const title = post.seoTitle || post.title;
const description = post.seoDescription || post.description;
const canonical = post.canonicalUrl || `https://saadsrabon.com/blog/${post.slug}/`;
const schema = { "@context": "https://schema.org", "@type": "BlogPosting", headline: post.title, description, datePublished: post.publishedAt?.toISOString(), dateModified: post.updatedAt.toISOString(), url: canonical, image: post.socialImage ? `https://saadsrabon.com${post.socialImage}` : "https://saadsrabon.com/social-card.png", author: { "@type": "Person", name: "Md Abul Hasnat Saad", url: "https://saadsrabon.com/" } };
const preview = post.status === "draft";
Astro.response.headers.set("Cache-Control", preview ? "private, no-store" : "public, max-age=60, s-maxage=300, stale-while-revalidate=600");
---
<SiteLayout active="blog" title={`${title} - Saad`} description={description} canonical={canonical} ogType="article" socialImage={post.socialImage || "/social-card.png"} noindex={preview} schema={schema}>
  <article class="container article-page">
    <a class="text-link case-back" href="/blog/">← Writing</a>
    <header class="article-header"><p class="eyebrow">{preview ? "Private draft preview" : "Writing"}</p><h1>{post.title}</h1><p>{post.description}</p><div class="blog-meta">{post.readTime || "Article"}{post.publishedAt && <> · <time datetime={post.publishedAt.toISOString()}>{post.publishedAt.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })}</time></>}</div></header>
    {post.coverImage && <figure class="article-cover"><img src={post.coverImage} alt={post.coverImageAlt ?? ""} /></figure>}
    <div class="article-body" set:html={bodyHtml} />
    {preview && <aside class="case-disclaimer"><strong>Unpublished draft</strong><p>This page is visible only to an authenticated administrator and is excluded from indexing.</p></aside>}
  </article>
</SiteLayout>
