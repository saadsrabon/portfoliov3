---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../data/site";
---
<SiteLayout title="Book a call — Saad" description="Request a 30-minute introductory video call with Saad. Contact by email to coordinate a suitable time.">
  <header class="narrow page-intro"><p class="eyebrow">Book a call</p><h1>Pick a time that works for both of us.</h1><p>A 30-minute video introduction is a chance to talk through a role or project, the main risks, and a useful next step.</p></header>
  <section class="narrow section">
    <div class="book-note" data-reveal>
      <h2 class="section-title" style="font-size:24px">A straightforward first conversation</h2>
      <p style="margin-top:12px">I’m based in Dhaka (GMT+6) and work with teams in the US and Australia. Email me a couple of times that suit you and your time zone, and we can coordinate directly.</p>
      <a class="button" href="mailto:saadsrabon2@gmail.com?subject=30-minute%20intro%20call&body=Hi%20Saad%2C%0D%0A%0D%0AI%27d%20like%20to%20talk%20about%20a%20role%20or%20project.%20Here%20are%20a%20few%20times%20that%20work%20for%20me%3A%0D%0A%0D%0AMy%20time%20zone%3A%0D%0A%0D%0AContext%3A%20">Email to arrange a call <span aria-hidden="true">↗</span></a>
      <p style="margin:18px 0 0;font-size:13px">Your email app will open with a draft. A time is not reserved until we confirm it together.</p>
    </div>
  </section>
</SiteLayout>
