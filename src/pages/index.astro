---
export const prerender = true;
import SiteLayout from "../layouts/SiteLayout.astro";
import { concepts, projects, site } from "../data/site";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  email: site.email,
  address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
  sameAs: [site.github, site.linkedin],
};
---
<SiteLayout active="profile" title="Saad — Full stack engineer in Dhaka" description={site.description} schema={personSchema}>
  <div class="container hero">
    <div>
      <p class="eyebrow">Full stack engineer · Dhaka, Bangladesh</p>
      <h1>From the pixel to the payment webhook, I ship the whole product.</h1>
      <p class="hero-copy">I build across frontend, backend, and infrastructure. Since moving from Botany into web development in 2022, I’ve worked on fintech, eSIM, CRM, and real-time products with teams in the US and Australia.</p>
      <div class="hero-actions">
        <a class="button" href="/book/">Book a 30-minute call <span aria-hidden="true">↗</span></a>
        <a class="button button-light" href="/work/">Explore selected work <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-note"><span class="availability"><span class="availability-dot" aria-hidden="true"></span>Open to remote roles and projects</span></p>
    </div>
    <div class="hero-visual" role="img" aria-label="Illustration of product work connecting frontend, APIs, data, and payments">
      <span class="orbit-center" aria-hidden="true">S.</span>
      <span class="orbit-chip one" aria-hidden="true">Interfaces</span>
      <span class="orbit-chip two" aria-hidden="true">APIs</span>
      <span class="orbit-chip three" aria-hidden="true">Data</span>
      <span class="orbit-chip four" aria-hidden="true">Payments</span>
    </div>
  </div>

  <section class="container section home-concept-section" aria-labelledby="concept-projects">
    <div class="section-head"><div><p class="eyebrow">Independent design concepts</p><h2 id="concept-projects">Four landing pages, made to explore.</h2></div><a class="text-link" href="/work/">All work <span aria-hidden="true">→</span></a></div>
    <p class="hero-copy home-concept-intro">Visual explorations across energy, climate, wellbeing, and care discovery. Each is clearly labeled as an independent concept, with authentic previews and a link to its live demo.</p>
    <div class="concept-grid" data-motion-stagger>
      {concepts.map((project) => <article class="concept-card" data-motion-card>
        <a class="concept-cover" href={`/work/${project.slug}/`} aria-label={`View ${project.name} concept case study`}>
          <img src={project.desktopImage} alt={`${project.name} concept landing page preview`} loading="lazy" />
          <span class="concept-open">View case study ↗</span>
        </a>
        <div class="concept-card-copy">
          <div class="concept-title"><div><p class="eyebrow">{project.category} · Concept</p><h3><a href={`/work/${project.slug}/`}>{project.name}</a></h3></div></div>
          <p>{project.summary}</p>
          <div class="concept-links"><a class="text-link" href={`/work/${project.slug}/`}>Case study <span aria-hidden="true">→</span></a><a class="live-link" href={project.url} target="_blank" rel="noopener noreferrer">Open live concept ↗</a></div>
        </div>
      </article>)}
    </div>
  </section>

  <section class="container section" aria-labelledby="profile-facts">
    <div class="section-head"><div><p class="eyebrow">A quick introduction</p><h2 id="profile-facts">A little about how I work</h2></div></div>
    <dl class="facts" data-motion-stagger>
      <div class="fact" data-motion-card><dt>Current role</dt><dd>Full Stack Engineer</dd></div>
      <div class="fact" data-motion-card><dt>Now</dt><dd>Digital Pylot · Dhaka</dd></div>
      <div class="fact" data-motion-card><dt>Open to</dt><dd>Remote roles and projects</dd></div>
      <div class="fact" data-motion-card><dt>Time zone</dt><dd>GMT+6 · overlap with EU and US hours</dd></div>
      <div class="fact" data-motion-card><dt>Core stack</dt><dd>NestJS, Next.js, PostgreSQL, Redis, AWS</dd></div>
      <div class="fact" data-motion-card><dt>Languages</dt><dd>Bengali, English (B2), German (A1)</dd></div>
    </dl>
  </section>

  <section class="container section" aria-labelledby="recent-work">
    <div class="section-head"><div><p class="eyebrow">Selected product work</p><h2 id="recent-work">Work built for real use</h2></div><a class="text-link" href="/work/">See all projects <span aria-hidden="true">→</span></a></div>
    <div class="project-list" data-motion-stagger>
      {projects.slice(0, 4).map((project) => <a class="project project-card-link" href={`/work/${project.slug}/`} aria-label={`Read the ${project.name} case study`} data-motion-card>
        <span class="project-group">{project.group}</span>
        <div class="project-copy"><h3>{project.name}</h3><p>{project.description}</p><div class="tag-list" aria-label="Technologies">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div>
        <span class="project-card-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>

  <section class="container section" aria-labelledby="journey-brief">
    <div class="section-head"><div><p class="eyebrow">A different starting point</p><h2 id="journey-brief">I learned to study a system before touching it.</h2></div><a class="text-link" href="/journey/">Read my journey <span aria-hidden="true">→</span></a></div>
    <p class="hero-copy">Botany trained me to look at how small parts affect the whole. That habit still shapes how I approach product engineering: understand the system, find the important edge cases, then build with care.</p>
  </section>

  <section class="container section" aria-labelledby="writing-preview">
    <div class="section-head"><div><p class="eyebrow">Notes from the work</p><h2 id="writing-preview">Writing in progress</h2></div><a class="text-link" href="/blog/">Open the writing desk <span aria-hidden="true">→</span></a></div>
    <p class="hero-copy">I'm shaping a few practical notes on payment retries and recoverable email imports. They're marked as drafts until they're ready to publish.</p>
  </section>

  <section class="container callout"><h2>Have a role or product in mind? Let's talk it through.</h2><a class="button" href="/book/">Book a 30-minute call <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
